# 既定：テキストは改行コードをLFに統一する（Unityのメタ/アセットはYAML）
* text=auto eol=lf

# Unity のテキスト系アセット（YAML）
*.cs        text diff=csharp
*.meta      text
*.unity     text
*.asset     text
*.prefab    text
*.mat       text
*.anim      text
*.controller text
*.physicMaterial text
*.inputactions text
*.shader    text
*.shadergraph text
*.json      text
*.md        text

# バイナリ（差分を取らない）
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.psd       binary
*.tga       binary
*.fbx       binary
*.obj       binary
*.blend     binary
*.wav       binary
*.mp3       binary
*.ogg       binary
*.ttf       binary
*.otf       binary
*.dll       binary
*.unitypackage binary
*.wlt       binary
